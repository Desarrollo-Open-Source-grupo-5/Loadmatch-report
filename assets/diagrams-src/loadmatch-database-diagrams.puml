title Database Diagram - Complete overview of the relational model
caption 17 tables with all their columns, grouped by schema - one schema per bounded context and one for the Notification component

package "iam" {
    entity "users" as users {
    * id : UUID <<PK>>
    --
    * email : VARCHAR(255) <<UQ>> <<CHK>>
    * password_hash : VARCHAR(255)
    * role : VARCHAR(20) <<CHK>>
    * verified : BOOLEAN
    * active : BOOLEAN
    * created_at : TIMESTAMPTZ
    last_access_at : TIMESTAMPTZ
    }
    entity "password_reset_tokens" as password_reset_tokens {
    * id : UUID <<PK>>
    --
    * user_id : UUID <<FK>>
