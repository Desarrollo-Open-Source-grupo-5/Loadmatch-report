' =============================================================================
'  LoadMatch Platform - Database Diagrams per Bounded Context
'  Section 4.8.1 of the report - Course 1ASI0729 - Group 5
'
'  SINGLE FILE: 9 @startuml blocks, one per bounded context with persistence,
'  plus block 10 for the transversal component Notification (US43).
'  Derived from the loadmatch-schema.sql schema, validated on PostgreSQL 16.
'
'  Matching does not appear: it is a query context without tables of its own.
'
'  -------------------------------------------------------------------------
'  CONVENTIONS
'  -------------------------------------------------------------------------
'     *            NOT NULL column
'     <<PK>>       Primary Key            <<FK>>   Foreign Key
'     <<UQ>>       UNIQUE constraint      <<CHK>>  CHECK constraint
'     <<VO>>       embedded column of a Value Object from the class model
'
'     ||--o{       one to zero-or-many
'     ||--||       one to one
'     ||--o|       one to zero-or-one
'
'  Tables in grey belong to ANOTHER bounded context and are shown only
'  with their primary key, because the reference is by identity.
' =============================================================================

' =============================================================================
'  1 - IAM
' =============================================================================
@startuml db-01-iam
hide circle
skinparam class {
    BackgroundColor #FDF6E3
    BorderColor #657B83
    BackgroundColor<<external>> #E8E8E8
    BorderColor<<external>> #AAAAAA
}
title Database Diagram - Bounded Context: IAM
caption schema iam - credentials, password recovery and account lifecycle

entity "users" as users {
    * id : UUID <<PK>>
    --
    * email : VARCHAR(255) <<UQ>> <<CHK>>
    * password_hash : VARCHAR(255)
    * role : VARCHAR(20) <<CHK>>
    * verified : BOOLEAN
    * active : BOOLEAN
    * created_at : TIMESTAMPTZ
    last_access_at : TIMESTAMPTZ
}

entity "shippers" as shippers <<external>> {
    * id : UUID <<PK>>
    * user_id : UUID <<FK>> <<UQ>>
}

entity "carriers" as carriers <<external>> {
    * id : UUID <<PK>>
    * user_id : UUID <<FK>> <<UQ>>
}

entity "password_reset_tokens" as password_reset_tokens {
    * id : UUID <<PK>>
    --
    * user_id : UUID <<FK>>
    * token_hash : VARCHAR(255) <<UQ>>
    * expires_at : TIMESTAMPTZ <<CHK>>
    * used : BOOLEAN
    * created_at : TIMESTAMPTZ
}

users ||--o| shippers : "has profile"
users ||--o| carriers : "has profile"
users ||--o{ password_reset_tokens : "recovers access with\nON DELETE CASCADE"

note bottom of password_reset_tokens
  Internal entity PasswordResetToken of the User aggregate.
  Valid for 30 minutes (US30); only the hash is stored.
end note

note bottom of users
  **role** allows resolving JWT authorization
  without querying the profiles schema.
  **CHECK**: role IN ('SHIPPER','CARRIER')
end note

legend right
  |= Symbol |= Meaning |
  | * | NOT NULL |
  | <<PK>> | Primary Key |
  | <<FK>> | Foreign Key |
  | <<UQ>> | UNIQUE |
  | <<CHK>> | CHECK |
  | grey | table from another bounded context |
endlegend
