' =============================================================================
'  LoadMatch Platform — Class Diagrams per Bounded Context (UML)
'  Section 4.7.1 of the report - Course 1ASI0729 - Group 5
'
'  SINGLE FILE: 10 @startuml blocks, one per bounded context, plus an
'  11th block for the cross-cutting Notification component (US43).
'  PlantUML generates one image per block. No remote includes.
'
'  -------------------------------------------------------------------------
'  CONVENTIONS APPLIED
'  -------------------------------------------------------------------------
'  Visibility (required by the assignment, section 4.7.1):
'     +  public        -  private        #  protected     ~  package-private
'
'  Stereotypes:
'     <<Aggregate Root>>          root of the aggregate; single entry point
'     <<Entity>>                  internal entity; only created through its root
'     <<Value Object (Record)>>   no identity of its own; immutable
'     <<Enumeration>>             closed set of domain states
'     <<Repository (Interface)>>  persistence contract; one per Aggregate Root
'     <<Port (Interface)>>        contract towards an external system (ACL)
'     <<Domain Event (Record)>>   business fact published by the aggregate
'     <<Domain Service>>          logic that does not belong to a single aggregate
'     <<Read Model>>              read-only projection
'     <<Shared Kernel>>           Value Object shared across bounded contexts
'
'  Relationships:
'     *-->   composition    the whole controls the lifecycle of the part
'     o-->   aggregation    weak or optional association
'     ..>    dependency     reference between aggregates BY IDENTITY, or use of a port
'
'  Modeling rules:
'   1. An aggregate NEVER references another aggregate by object, only by its typed Id.
'   2. Identifiers are Value Objects over UUID (prevents mixing up
'      a VehicleId with a CarrierId at compile time).
'   3. Internal entities declare a package-private constructor (~).
'   4. Aggregates expose business methods, never setters.
'   5. One repository per Aggregate Root; internal entities do not get their own.
' =============================================================================


' =============================================================================
'  BOUNDED CONTEXT 1 — IAM
' =============================================================================
@startuml class-01-iam
skinparam classAttributeIconSize 0
title Class Diagram — Bounded Context: IAM
caption Credentials, authentication and account lifecycle

package "com.loadmatch.iam.domain.model.valueobjects" {
    class "UserId" <<Value Object (Record)>> {
        +value : UUID
        --
        +UserId()
        +UserId(value: UUID)
        +{static} of(value: String) : UserId
    }
    class "Email" <<Value Object (Record)>> {
        +value : String
        --
        +Email(value: String)
        -validateFormat(value: String) : void
        +domain() : String
    }
    class "PasswordHash" <<Value Object (Record)>> {
        +value : String
        --
        +PasswordHash(value: String)
    }
    enum "UserRole" <<Enumeration>> {
        SHIPPER
        CARRIER
    }
}

package "com.loadmatch.iam.domain.model.entities" {
    entity "PasswordResetToken" <<Entity>> {
        -id : UUID
        -tokenHash : String
        -expiresAt : LocalDateTime
        -used : boolean
        -createdAt : LocalDateTime
        --
        ~PasswordResetToken(tokenHash: String, validityMinutes: int)
        +isValid() : boolean
        +markAsUsed() : void
    }
}

package "com.loadmatch.iam.domain.model.aggregates" {
    entity "User" <<Aggregate Root>> {
        -id : UserId
        -email : Email
        -passwordHash : PasswordHash
        -role : UserRole
        -verified : boolean
        -active : boolean
        -createdAt : LocalDateTime
        -lastAccessAt : LocalDateTime
        -passwordResetTokens : List<PasswordResetToken>
        --
        +User(email: Email, passwordHash: PasswordHash, role: UserRole)
        +verifyAccount() : void
        +recordAccess() : void
        +changePassword(newPassword: PasswordHash) : void
        +deactivate() : void
        +requestPasswordReset() : PasswordResetToken
        +resetPassword(token: String, newPassword: PasswordHash) : void
        +isEnabled() : boolean
        +getId() : UserId
        +getEmail() : Email
        +getRole() : UserRole
        -ensureNotDeactivated() : void
    }
}

package "com.loadmatch.iam.domain.model.events" {
    class "UserRegistered" <<Domain Event (Record)>> {
        +userId : UserId
        +email : Email
        +role : UserRole
        +occurredAt : LocalDateTime
    }
    class "AccountVerified" <<Domain Event (Record)>> {
        +userId : UserId
        +occurredAt : LocalDateTime
    }
    class "PasswordResetRequested" <<Domain Event (Record)>> {
        +userId : UserId
        +email : Email
        +expiresAt : LocalDateTime
        +occurredAt : LocalDateTime
    }
}

package "com.loadmatch.iam.domain.repositories" {
    interface "UserRepository" <<Repository (Interface)>> {
        +findById(id: UserId) : Optional<User>
        +findByEmail(email: Email) : Optional<User>
        +existsByEmail(email: Email) : boolean
        +save(user: User) : User
    }
}

package "com.loadmatch.iam.domain.services" {
    interface "PasswordHasher" <<Port (Interface)>> {
        +hash(plain: String) : PasswordHash
        +matches(plain: String, hash: PasswordHash) : boolean
    }
}

User *--> "1" UserId : identified by >
User *--> "1" Email : authenticates with >
User *--> "1" PasswordHash : secures its access with >
User *--> "1" UserRole : operates under the >

User ..> "0..*" UserRegistered : publishes >
User ..> "0..*" AccountVerified : publishes >
User *--> "0..*" PasswordResetToken : recovers its access with >
User ..> "0..*" PasswordResetRequested : publishes >
UserRepository ..> "0..*" User : persists and retrieves >
User ..> "1" PasswordHasher : delegates hashing to >

legend right
  |= Symbol |= Meaning |
  | + | public |
  | - | private |
  | # | protected |
  | ~ | package-private |
  | *--> | composition |
  | o--> | aggregation |
  | ..> | dependency / reference by Id |
endlegend
@enduml


